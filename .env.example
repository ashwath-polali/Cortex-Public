# ---- required ----
MONGODB_URI=mongodb+srv://user:password@cluster.example.mongodb.net
ANTHROPIC_API_KEY=
# long random string; keeps logins valid across restarts
FLASK_SECRET_KEY=
# the first login with this password creates the owner account
CORTEX_PASSWORD=
# bearer key that maps /mcp requests to the owner account
CORTEX_MCP_KEY=
# your deployed URL, e.g. https://cortex.example.com
CORS_ORIGIN=

# ---- optional ----
MONGODB_DB=cortex
MONGODB_COLLECTION=memories
CORTEX_MODEL=claude-haiku-4-5-20251001
# in-app AI calls per day for non-owner accounts
AI_DAILY_QUOTA=10
# storage cap per non-owner account, in bytes
MAX_BRAIN_BYTES=2000000
# max characters returned by a multi-cluster read
CORTEX_READ_BUDGET=24000
# local stdio MCP server: which account to use (default: the owner)
CORTEX_USER_ID=
# set to 1 to skip the login form locally once an owner account exists
CORTEX_DEV=
HOST=127.0.0.1
PORT=5000
